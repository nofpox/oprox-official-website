# =============================================================================
# OPROX Official Website — Environment Variables
# Copy this file to .env and fill in the real values.
# Variables prefixed with VITE_ are exposed to the browser bundle.
# Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# PORT: HTTP port the production server (server.js) listens on.
# Default: 3000
PORT=3000

# NODE_ENV: Set to "production" in production deployments.
# Controls HSTS header, CORS strictness, and cache headers.
NODE_ENV=development

# APP_URL / ALLOWED_ORIGIN: The canonical URL of the website.
# Used for CORS origin validation in production and for self-referential links.
APP_URL=https://oprox.sa
ALLOWED_ORIGIN=https://oprox.sa

# -----------------------------------------------------------------------------
# Contact Form Email Delivery (optional — Resend)
# If not set, form submissions are logged server-side only.
# -----------------------------------------------------------------------------

# RESEND_API_KEY: API key from Resend (https://resend.com).
# Required for email delivery from the contact form.
RESEND_API_KEY=re_...

# SENDER_EMAIL: The "From" address shown in outgoing emails.
SENDER_EMAIL=OPROX Website <noreply@oprox.sa>

# RECIPIENT_EMAIL: Where contact form submissions are sent.
# Defaults to SENDER_EMAIL if not set.
RECIPIENT_EMAIL=hello@oprox.sa

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: Google Gemini API key.
# Required only if AI-powered features are enabled server-side.
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Product App URLs (VITE_ prefix — exposed to the browser bundle)
# These control where the "Open Product" / "Sign In" buttons redirect users.
# Leave empty to keep a product in "Official Gateway" mode (no external redirect).
# -----------------------------------------------------------------------------

# VITE_OPROX_OS_URL: Full URL of the deployed OPROX OS app.
# Example: https://os.oprox.sa
VITE_OPROX_OS_URL=

# VITE_OPROX_CODE_URL: Full URL of the deployed OPROX Code app.
# Example: https://code.oprox.sa
VITE_OPROX_CODE_URL=

# VITE_OPROX_STUDIO_URL: Full URL of the deployed OPROX Studio app.
# Example: https://studio.oprox.sa
VITE_OPROX_STUDIO_URL=

# VITE_OPROX_REAL_ESTATE_URL: Full URL of the deployed OPROX Real Estate app.
# Example: https://realestate.oprox.sa
VITE_OPROX_REAL_ESTATE_URL=

# VITE_OPROX_ACADEMY_URL: Full URL of the deployed OPROX Academy app.
# Example: https://academy.oprox.sa
VITE_OPROX_ACADEMY_URL=

# -----------------------------------------------------------------------------
# Auth & Account Integration (VITE_ prefix — exposed to the browser bundle)
# Required only when the shared OPROX Account Provider is connected.
# Leave empty while running in frontend-only / NOT_CONFIGURED mode.
# -----------------------------------------------------------------------------

# VITE_OPROX_AUTH_ENDPOINT: Shared SSO auth endpoint URL.
VITE_OPROX_AUTH_ENDPOINT=

# VITE_OPROX_ACCOUNT_ENDPOINT: Account profile and session endpoint URL.
VITE_OPROX_ACCOUNT_ENDPOINT=

# VITE_OPROX_BILLING_ENDPOINT: Billing portal redirect / checkout endpoint URL.
VITE_OPROX_BILLING_ENDPOINT=

# VITE_OPROX_ENTITLEMENT_ENDPOINT: Product entitlement check endpoint URL.
VITE_OPROX_ENTITLEMENT_ENDPOINT=
